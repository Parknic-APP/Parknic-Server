# 로컬 DB(docker-compose.yaml)와 운영 구성(docker-compose.prod.yaml)이 함께 쓰는 값
DB_URL=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# 운영(docker-compose.prod.yaml)에서 필요한 값
# JWT_SECRET: 32자 이상 랜덤 문자열 (예: openssl rand -base64 48)
JWT_SECRET=
# APPLE_CLIENT_ID: 앱의 Bundle ID (생략하면 com.hwangsanghwan.parknic)
APPLE_CLIENT_ID=
# Apple 탈퇴 시 연결 해제(revoke)에 필요한 값. 비어 있으면 이 기능만 건너뛴다
# APPLE_TEAM_ID: Apple Developer > Membership의 Team ID
APPLE_TEAM_ID=
# APPLE_KEY_ID: Sign in with Apple이 켜진 키의 Key ID
APPLE_KEY_ID=
# APPLE_PRIVATE_KEY: .p8 파일 내용 전체를 한 줄로(줄바꿈은 \n으로 바꿔서). 절대 Git에 올리지 않는다
APPLE_PRIVATE_KEY=
# REVIEW_MODE: 앱 심사 기간에만 true (심사용 공원 노출). 평소에는 false 또는 비움
REVIEW_MODE=
# DOMAIN: 서버의 도메인 (예: api.example.com). Caddy가 이 도메인의 HTTPS 인증서를 자동 발급한다. 로컬 확인은 localhost
DOMAIN=
# HTTP_PORT, HTTPS_PORT: 호스트에 열 포트 (생략하면 80, 443). 운영에서는 바꾸지 않는다
HTTP_PORT=
HTTPS_PORT=
# COMPOSE_PROJECT_NAME: 같은 머신에서 여러 구성을 구분할 때만 사용 (생략 가능)
COMPOSE_PROJECT_NAME=
