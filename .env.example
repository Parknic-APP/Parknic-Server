# 로컬 DB(docker-compose.yaml)와 운영 구성(docker-compose.prod.yaml)이 함께 쓰는 값
DB_URL=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# 운영(docker-compose.prod.yaml)에서 필요한 값
# JWT_SECRET: 32자 이상 랜덤 문자열 (예: openssl rand -base64 48)
JWT_SECRET=
# APPLE_CLIENT_ID: 앱의 Bundle ID (생략하면 com.hwangsanghwan.parknic)
APPLE_CLIENT_ID=
# APP_PORT: 호스트에 열 포트 (생략하면 8080)
APP_PORT=
